{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "cfr2upload",
    "compatibility_date": "2026-01-01",
    "main": "src/worker.ts",
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": "shared"
        }
    ],
    "assets": {
        "directory": "src/static"
    },
    "kv_namespaces": [
        {
            "id": "08955b4bd64a4dc798384d133596c10d",
            "binding": "AUTH_KV"
        }
    ],
    "routes": [
        {
            "pattern": "files.sugoidogo.com/*",
            "zone_name": "sugoidogo.com"
        }
    ]
}